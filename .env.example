# ==============================================================================
# Electronic-Arena Environment Configuration & Database Credentials
# ==============================================================================

# Admin Portal Password (default: aiml)
ADMIN_PASSWORD=aiml

# Server Port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB Atlas / Remote Database)
# Recommended for Cloud & Serverless deployments (Vercel, Render, Railway, Fly.io)
# ------------------------------------------------------------------------------
# Option 1: Full Connection String URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/electronic_arena?retryWrites=true&w=majority

# Option 2: Discrete Credentials (Alternative to MONGODB_URI)
# DB_USER=my_db_user
# DB_PASSWORD=my_secure_password
# DB_CLUSTER=cluster0.mongodb.net
# DB_NAME=electronic_arena

# ------------------------------------------------------------------------------
# EMAIL ALERTS WEBHOOK (Optional)
# ------------------------------------------------------------------------------
ALERT_EMAIL_WEBHOOK_URL=
ALERT_EMAIL_TO=gxwr143@gmail.com
